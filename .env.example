# 协议格式：openai = Chat Completions 兼容；anthropic = Messages 兼容。不是模型品牌限制。
YUKII_API_FORMAT=openai
# API 根地址，包含版本前缀；程序追加 /chat/completions 或 /messages。
# 填写实际使用的模型服务地址，例如自建网关、代理或兼容服务。
YUKII_API_BASE_URL=https://api.example.com/v1
YUKII_API_KEY=
YUKII_MODEL=
# Computer Use 需要模型支持图像输入；默认 false，桌面宿主会显式拒绝启动。
# 设为 true 只代表用户声明模型支持视觉，不代表已授予系统屏幕录制/辅助功能权限。
YUKII_VISION_INPUT=false

# 可选：网关路径不标准时填写完整请求地址，覆盖 BASE_URL 的拼接结果。
YUKII_API_ENDPOINT=
# Messages 协议版本请求头。
YUKII_ANTHROPIC_VERSION=2023-06-01
# Chat Completions 输出限制字段：max_completion_tokens 或 max_tokens（兼容旧网关）。
YUKII_OPENAI_TOKEN_FIELD=max_completion_tokens
YUKII_MAX_OUTPUT_TOKENS=4096
YUKII_CONTEXT_WINDOW_TOKENS=1000000
YUKII_REQUEST_TIMEOUT_SECONDS=90

# 单个任务的轮数、工具调用数、累计 token 上限及总超时。
YUKII_AGENT_MAX_TURNS=80
YUKII_AGENT_MAX_TOOL_CALLS=200
YUKII_AGENT_MAX_TOTAL_TOKENS=1000000
YUKII_AGENT_TIMEOUT_SECONDS=900
YUKII_DATA_DIR=.data
# 未绑定项目时，会话文件默认目录的根路径；留空使用 ~/Yukii/chats。
YUKII_WORKSPACE_ROOT=

# 沙箱默认 docker；disabled 仅停用容器工具，不影响知识库和纯文本技能。
YUKII_SANDBOX_BACKEND=docker
YUKII_SANDBOX_TIMEOUT_SECONDS=30
# 留空使用 Docker 默认 runtime。Linux 安装并配置 gVisor 后可选 runsc。
YUKII_DOCKER_RUNTIME=

# 默认使用随项目提供的示例市场。URL 非空时覆盖 DIR，指向 HTTPS index.json。
YUKII_PLUGIN_MARKETPLACE_DIR=examples/marketplace
YUKII_PLUGIN_MARKETPLACE_URL=

# 可选文本语义检索。密钥和模型同时留空时只使用 BM25；仅填一项将拒绝启动。
# 兼容已有 YUKII_EMBEDDING_API 密钥别名；不复用聊天模型的密钥。
YUKII_EMBEDDING_API_KEY=
# 填写文本向量模型 ID（不是多模态模型）。
YUKII_EMBEDDING_MODEL_ID=
YUKII_EMBEDDING_FORMAT=openai
# 填写完整的 HTTPS 根地址；程序分别追加对应的 embedding 路径。
YUKII_EMBEDDING_OPENAI_BASE_URL=
YUKII_EMBEDDING_DASHSCOPE_BASE_URL=
# 可选完整请求地址，优先于上述 BASE_URL；不读取无协议的 EMBEDDING_BASE_URL。
YUKII_EMBEDDING_ENDPOINT=
YUKII_EMBEDDING_DIMENSIONS=1024
YUKII_EMBEDDING_TIMEOUT_SECONDS=60

# 桌面 Computer Use 独立预算；不读取上面的 YUKII_AGENT_* 网页预算。
# 不设置时默认 80 轮、240 次工具、1500000 token、3600 秒。
# YUKII_DESKTOP_MAX_TURNS=80
# YUKII_DESKTOP_MAX_TOOL_CALLS=240
# YUKII_DESKTOP_MAX_TOTAL_TOKENS=1500000
# YUKII_DESKTOP_TIMEOUT_SECONDS=3600

# 可选：MCP stdio server 配置文件；不设置则不加载 MCP。
YUKII_MCP_CONFIG=examples/mcp/cua-servers.example.json

# 可选：Office 文档生成依赖的 Python 与 bridge；默认 python3 + 仓库内 bridge。
# 默认 python3 需安装 python-docx/openpyxl/python-pptx；生产建议固定绝对路径。
# YUKII_OFFICE_PYTHON=/path/to/python3
# YUKII_OFFICE_BRIDGE=services/office-tools/office_bridge.py
# YUKII_OFFICE_TIMEOUT_SECONDS=60
# PDF 导出需要 LibreOffice Kit 的 Node 与 cli 绝对路径。
# YUKII_OFFICE_PDF_NODE=/path/to/node
# YUKII_OFFICE_PDF_CLI=/path/to/libreoffice-kit/lib/cli.js


# 可选：Web search（密钥默认复用 YUKII_API_KEY；留空时使用内置默认配置）
YUKII_WEB_SEARCH_BASE_URL=
YUKII_WEB_SEARCH_MODEL=
YUKII_WEB_SEARCH_MAX_USES=5
YUKII_WEB_SEARCH_MAX_RESULTS=10
